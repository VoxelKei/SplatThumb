<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for SplatThumb. Installs without administrator rights, writes only to the
  current user's profile and HKEY_CURRENT_USER, and removes everything it wrote on uninstall.

  Built by the `msi` CMake target (installer/CMakeLists.txt), which passes:
    Version          from project(VERSION) in the top-level CMakeLists.txt
    ShellExtDll      the built splatthumb_shellext.dll
    AppExe           the built SplatThumb.exe (settings and viewpoint windows)
    CustomActionDll  the built splatthumb_ca.dll
    LicenseFile      the repository's LICENSE
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The UpgradeCode never changes: it is how a new version finds and replaces an old one. -->
  <Package Name="SplatThumb"
           Manufacturer="VoxelKei"
           Version="$(var.Version)"
           UpgradeCode="{512DFF52-226B-42AE-AB47-C4C0A71D1B52}"
           Scope="perUser"
           Compressed="yes">

    <!-- Installing any other build, even of the same version, replaces the installed one, so
         there is never more than one SplatThumb in Settings > Apps. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of SplatThumb is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VoxelKei/SplatThumb" />

    <!-- %LOCALAPPDATA%\Programs\SplatThumb, the usual place for per-user programs. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SplatThumb" />
      </Directory>
    </StandardDirectory>

    <!-- Files in the user profile need a registry key path (ICE38) and must be removed
         explicitly (ICE64). RemoveFolder only removes a folder that is empty. WiX cannot
         generate GUIDs for such components, so they are fixed here: never change them, and
         never reuse them for other contents. -->
    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Id="ShellExt" Guid="{0FAF3E8E-84B7-489F-AF07-FD583F4A4F59}">
        <File Id="ShellExtDll" Source="$(var.ShellExtDll)" Name="splatthumb_shellext.dll" />
        <RegistryValue Root="HKCU" Key="Software\SplatThumb" Name="ShellExt" Type="integer" Value="1" KeyPath="yes" />
        <!-- The CLSID values (the same as tools/dev/Register-Dev.ps1), in the DLL's component
             so they are installed and removed with it. No DisableProcessIsolation: Explorer
             runs the handler in a separate process. The .ply\ShellEx value is written by the
             custom actions below. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}"
                       Type="string" Value="SplatThumb Thumbnail Handler" />
        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}\InprocServer32"
                       Type="string" Value="[#ShellExtDll]" />
        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}\InprocServer32"
                       Name="ThreadingModel" Type="string" Value="Apartment" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="License" Guid="{21621126-0300-4528-8167-E9160D24AE2B}">
        <File Id="LicenseTxt" Source="$(var.LicenseFile)" Name="LICENSE.txt" />
        <RegistryValue Root="HKCU" Key="Software\SplatThumb" Name="License" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- The settings window (Start menu > SplatThumb) and the viewpoint window (from the
           .ply right-click item, which the custom actions below write). -->
      <Component Id="App" Guid="{567BEEEC-BA3F-4D3D-BD14-E3434A932D1D}">
        <File Id="AppExe" Source="$(var.AppExe)" Name="SplatThumb.exe" />
        <Shortcut Id="AppShortcut" Directory="ProgramMenuFolder" Name="SplatThumb"
                  Description="SplatThumb settings" Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\SplatThumb" Name="App" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- HKCU\Software\Classes\.ply\ShellEx\{e357...} and the right-click item under
         HKCU\Software\Classes\SystemFileAssociations\.ply\shell: Windows Installer would
         delete every key it leaves empty, including a .ply key that was there before. So a
         custom action saves what is there (to HKCU\Software\SplatThumb\Previous), points the
         handler at SplatThumb and adds the item, and another puts back exactly what was
         saved. Each has a rollback twin that undoes it if the install or uninstall fails later. Both also tell the shell
         that file associations changed. See customaction/ply_registration.h. -->
    <Binary Id="CustomActions" SourceFile="$(var.CustomActionDll)" />
    <CustomAction Id="RegisterPly" BinaryRef="CustomActions" DllEntry="RegisterPly"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RegisterPlyRollback" BinaryRef="CustomActions" DllEntry="RestorePly"
                  Execute="rollback" Impersonate="yes" Return="ignore" />
    <CustomAction Id="RestorePly" BinaryRef="CustomActions" DllEntry="RestorePly"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RestorePlyRollback" BinaryRef="CustomActions" DllEntry="RegisterPly"
                  Execute="rollback" Impersonate="yes" Return="ignore" />
    <!-- RegisterPly (and its use as a rollback) gets the path of SplatThumb.exe for the
         right-click item. INSTALLFOLDER is known in uninstalls too, unlike [#AppExe]. -->
    <SetProperty Id="RegisterPly" Value="[INSTALLFOLDER]SplatThumb.exe" Before="RegisterPly" Sequence="execute" />
    <SetProperty Id="RestorePlyRollback" Value="[INSTALLFOLDER]SplatThumb.exe" Before="RestorePlyRollback" Sequence="execute" />
    <!-- Uninstalling also deletes what SplatThumb.exe saved: the settings and the saved views
         (%LOCALAPPDATA%\SplatThumb). A commit action runs only once the uninstall has
         succeeded, so a failed uninstall keeps them. Not when an upgrade removes the older
         version (UPGRADINGPRODUCTCODE is set then), so upgrading keeps them. -->
    <CustomAction Id="RemoveUserData" BinaryRef="CustomActions" DllEntry="RemoveUserData"
                  Execute="commit" Impersonate="yes" Return="ignore" />
    <!-- Only for CI: msiexec ... SPLATTHUMB_FAIL_FOR_TEST=1 makes the install or uninstall
         fail after the changes above, to check the rollback. -->
    <CustomAction Id="FailForTest" BinaryRef="CustomActions" DllEntry="FailForTest"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="RestorePlyRollback" Before="RestorePly" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RestorePly" Before="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterPlyRollback" Before="RegisterPly" Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RegisterPly" After="WriteRegistryValues" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveUserData" After="RestorePly" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="FailForTest" After="RegisterPly" Condition="SPLATTHUMB_FAIL_FOR_TEST = &quot;1&quot;" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="Files" />
    </Feature>
  </Package>
</Wix>
