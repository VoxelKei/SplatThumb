<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for SplatThumb. Installs without administrator rights, writes only to the
  current user's profile and HKEY_CURRENT_USER, and removes everything it wrote on uninstall.

  Built by the `msi` CMake target (installer/CMakeLists.txt), which passes:
    Version      from project(VERSION) in the top-level CMakeLists.txt
    ShellExtDll  the built splatthumb_shellext.dll
    LicenseFile  the repository's LICENSE
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The UpgradeCode never changes: it is how a new version finds and replaces an old one. -->
  <Package Name="SplatThumb"
           Manufacturer="VoxelKei"
           Version="$(var.Version)"
           UpgradeCode="{512DFF52-226B-42AE-AB47-C4C0A71D1B52}"
           Scope="perUser"
           Compressed="yes">

    <!-- Installing any other build, even of the same version, replaces the installed one, so
         there is never more than one SplatThumb in Settings > Apps. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of SplatThumb is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/VoxelKei/SplatThumb" />

    <!-- %LOCALAPPDATA%\Programs\SplatThumb, the usual place for per-user programs. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SplatThumb" />
      </Directory>
    </StandardDirectory>

    <!-- Files in the user profile need a registry key path (ICE38) and must be removed
         explicitly (ICE64). RemoveFolder only removes a folder that is empty. WiX cannot
         generate GUIDs for such components, so they are fixed here: never change them, and
         never reuse them for other contents. -->
    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component Id="ShellExt" Guid="{0FAF3E8E-84B7-489F-AF07-FD583F4A4F59}">
        <File Id="ShellExtDll" Source="$(var.ShellExtDll)" Name="splatthumb_shellext.dll" />
        <RegistryValue Root="HKCU" Key="Software\SplatThumb" Name="ShellExt" Type="integer" Value="1" KeyPath="yes" />
        <!-- The same four values as tools/dev/Register-Dev.ps1, in the DLL's component so
             they are installed and removed with it. No DisableProcessIsolation: Explorer
             runs the handler in a separate process. -->
        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}"
                       Type="string" Value="SplatThumb Thumbnail Handler" />
        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}\InprocServer32"
                       Type="string" Value="[#ShellExtDll]" />
        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}\InprocServer32"
                       Name="ThreadingModel" Type="string" Value="Apartment" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.ply\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}"
                       Type="string" Value="{09C68D16-D21F-4B95-97A1-29B45AEBF4CC}" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
      <Component Id="License" Guid="{21621126-0300-4528-8167-E9160D24AE2B}">
        <File Id="LicenseTxt" Source="$(var.LicenseFile)" Name="LICENSE.txt" />
        <RegistryValue Root="HKCU" Key="Software\SplatThumb" Name="License" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="Files" />
    </Feature>
  </Package>
</Wix>
